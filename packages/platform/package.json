{
  "name": "@repo/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Módulos NestJS transversales que comparten api y worker (reloj, auditoría, outbox, idempotencia).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "@repo/observability": "workspace:*",
    "ioredis": "6.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/testing": "12.5.1",
    "@repo/config": "workspace:*",
    "@repo/testing": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
