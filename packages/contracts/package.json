{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos públicos de la API (esquemas Zod compartidos con la web y los proveedores).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/config": "workspace:*"
  }
