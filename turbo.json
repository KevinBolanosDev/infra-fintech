{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.spec.ts", "!test/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["transit", "^build", "build"],
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_CONFIG", "DOCKER_CERT_PATH", "DOCKER_TLS_VERIFY"],
      "outputs": [],
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["$TURBO_DEFAULT$", "!apps/**", "!packages/**"],
      "outputs": []
    },
    "//#lint:boundaries": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "APP_ENV",
        "HTTP_PORT",
        "ALLOWED_ORIGINS",
        "LOG_LEVEL",
        "TRUST_PROXY",
        "HTTP_BODY_LIMIT",
        "CLOCK_MODE",
        "REDIS_URL"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
