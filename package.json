{
  "name": "fintech-arriendos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:root lint:boundaries",
    "lint:root": "eslint --max-warnings=0 eslint.config.js eslint.boundaries.config.js",
    "lint:boundaries": "eslint --max-warnings=0 --config eslint.boundaries.config.js .",
    "lint:format": "prettier --check .",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@repo/config": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.10.0",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
