{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "API HTTP de la plataforma (NestJS 12, ESM, Express).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js)",
    "start": "node dist/main.js",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@repo/observability": "workspace:*",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@repo/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
