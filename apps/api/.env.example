# Variables de apps/api (sub-fase 0.8). Valores SINTÉTICOS de desarrollo: nunca credenciales reales.
# `pnpm dev` carga apps/api/.env si existe (cópialo desde este archivo; está ignorado por git).

# Ambiente: local | test | staging | sandbox | production
APP_ENV=local
# Puerto HTTP (0 = uno libre al azar, solo en local y test)
HTTP_PORT=3000
# Orígenes permitidos para CORS, separados por comas: http(s)://host[:puerto], sin *, ruta ni barra final.
# Fuera de local y test: solo https:// y nunca localhost, 127.0.0.1 ni ::1.
ALLOWED_ORIGINS=http://localhost:3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# false o el número de proxies de confianza (1 a 10) delante de la API
TRUST_PROXY=false
# Tamaño máximo del cuerpo de una petición (b, kb o mb)
HTTP_BODY_LIMIT=100kb
# Reloj de negocio (ADR-0011): system (hora real) o controllable (desfase en Redis; nunca en production)
CLOCK_MODE=system
# Redis del reloj controlable: obligatorio solo con CLOCK_MODE=controllable (el de infra/docker en local)
# REDIS_URL=redis://127.0.0.1:6379
