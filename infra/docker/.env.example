# Valores SINTÉTICOS de desarrollo local (sub-fase 0.6). Nunca pongas aquí credenciales reales.
# Para usar valores propios, copia este archivo a infra/docker/.env (ignorado por git) y pásalo con --env-file.

# Puertos publicados solo en 127.0.0.1. Cámbialos si chocan con otros contenedores (p. ej. aios-postgres / aios-redis).
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Superusuario de PostgreSQL: solo para el arranque del contenedor.
POSTGRES_SUPERUSER_PASSWORD=local-dev-superuser

# Roles de la base `fintech` (ver infra/docker/postgres/init/01-roles-y-bases.sh).
FINTECH_OWNER_PASSWORD=local-dev-owner
FINTECH_APP_PASSWORD=local-dev-app
FINTECH_READONLY_PASSWORD=local-dev-readonly
